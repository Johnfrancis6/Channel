{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "state.json",
  "description": "Etat detaille d'une video du pipeline. Source de verite : skills/new-short/assets/state_template.json (§13). Reference architecture : docs/architecture_chaine_v1.2.md §5.",
  "type": "object",
  "required": [
    "version_schema", "video_id", "cree_le", "cree_par", "titre_travail", "sujet", "angle",
    "sujet_id", "pilier", "voie", "consignes", "statut_global", "etape_actuelle",
    "etapes", "publication", "historique"
  ],
  "properties": {
    "version_schema": { "type": "integer" },
    "video_id": { "type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}_v[0-9]{2,}$" },
    "cree_le": { "type": ["string", "null"] },
    "cree_par": { "type": "string" },
    "titre_travail": { "type": ["string", "null"] },
    "sujet": { "type": ["string", "null"] },
    "angle": { "type": ["string", "null"] },
    "sujet_id": { "type": ["string", "null"] },
    "pilier": {
      "type": ["string", "null"],
      "enum": ["actu_ia", "avis_outil", "concept", "projet_perso", "tuto", "a_determiner", null]
    },
    "voie": { "type": ["string", "null"], "enum": ["tampon", "rapide", null] },
    "consignes": {
      "type": "object",
      "properties": {
        "mode_recherche": { "type": ["string", "null"] },
        "note_franco": { "type": ["string", "null"] }
      }
    },
    "statut_global": {
      "type": "string",
      "enum": ["idee", "sujet_valide", "en_production", "prete", "programmee", "publiee", "abandonnee", "attente_franco"]
    },
    "etape_actuelle": { "type": "string" },
    "etapes": {
      "type": "object",
      "properties": {
        "E1_recherche": { "$ref": "#/definitions/etape_agent" },
        "CP1": { "$ref": "#/definitions/checkpoint" },
        "E2_redaction": { "$ref": "#/definitions/etape_agent" },
        "E3_filtre": { "$ref": "#/definitions/etape_agent" },
        "CP2": { "$ref": "#/definitions/checkpoint" },
        "E4_audio": { "$ref": "#/definitions/etape_agent" },
        "E5_storyboard": { "$ref": "#/definitions/etape_agent" },
        "E6_montage": { "$ref": "#/definitions/etape_agent" },
        "CP3": { "$ref": "#/definitions/checkpoint_cp3" },
        "E7_publication": { "$ref": "#/definitions/etape_agent" }
      },
      "additionalProperties": false
    },
    "publication": {
      "type": "object",
      "properties": {
        "date_prevue": { "type": ["string", "null"] },
        "date_effective": { "type": ["string", "null"] },
        "url": { "type": ["string", "null"] }
      },
      "required": ["date_prevue", "date_effective", "url"]
    },
    "historique": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["horodatage", "agent", "evenement", "message"],
        "properties": {
          "horodatage": { "type": "string" },
          "agent": { "type": "string" },
          "evenement": { "type": "string" },
          "message": { "type": "string" }
        }
      }
    }
  },
  "definitions": {
    "etape_agent": {
      "type": "object",
      "required": ["agent", "statut", "tentatives", "debut", "fin", "sorties"],
      "properties": {
        "agent": { "type": "string" },
        "statut": {
          "type": "string",
          "enum": ["a_venir", "en_cours", "termine", "echec", "alerte", "attente_franco"]
        },
        "tentatives": { "type": "integer", "minimum": 0 },
        "debut": { "type": ["string", "null"] },
        "fin": { "type": ["string", "null"] },
        "sorties": { "type": "array", "items": { "type": "string" } },
        "message": { "type": ["string", "null"] }
      }
    },
    "checkpoint": {
      "type": "object",
      "required": ["statut", "commentaire", "date"],
      "properties": {
        "statut": {
          "type": "string",
          "enum": ["a_venir", "attente_validation", "valide", "refuse"]
        },
        "commentaire": { "type": ["string", "null"] },
        "date": { "type": ["string", "null"] }
      }
    },
    "checkpoint_cp3": {
      "allOf": [
        { "$ref": "#/definitions/checkpoint" },
        {
          "type": "object",
          "properties": {
            "seo": {
              "type": "object",
              "properties": {
                "titre": { "type": ["string", "null"] },
                "description": { "type": ["string", "null"] },
                "tags": { "type": "array", "items": { "type": "string" } }
              }
            }
          }
        }
      ]
    }
  }
}
